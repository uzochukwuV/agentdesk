# --- Mode ---
# true  = paper (simulated fills at real book prices)
# false = live on-chain trading; each desk gets its own wallet
PAPER_TRADES=true

# --- Per-agent wallets (live mode) ---
# In live mode the app generates one key per desk and persists them in
# data/agentWallets.json (gitignored). Fund each address with STT (gas);
# the app will mint each desk 10k tUSDC from the venue faucet.
# To override a generated wallet, set any of:
# AGENT_MOMENTUM_PRIVATE_KEY=0x...
# AGENT_MEANREV_PRIVATE_KEY=0x...
# AGENT_MISPRICING_PRIVATE_KEY=0x...
# AGENT_BREAKOUT_PRIVATE_KEY=0x...
# AGENT_QUORUM_PRIVATE_KEY=0x...
# Legacy shortcut: one key shared by all desks:
# PRIVATE_KEY=0x...

# Safety switch: only actually submit on-chain orders when you have funded
# the desks with STT gas. Wallets + balances still show with this false.
ENABLE_LIVE_TRADING=false

PORT=12000
# DREAMDEX_NETWORK=testnet
# HTTP_RPC_URL=https://api.infra.testnet.somnia.network
